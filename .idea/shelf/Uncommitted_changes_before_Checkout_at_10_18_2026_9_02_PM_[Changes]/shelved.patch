+package edp.app.ecotrack.data
+
+import edp.app.ecotrack.BuildConfig
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONObject
+import java.io.IOException
+
+object SupabaseAuthService {
+
+    private val client = OkHttpClient()
+
+    private val jsonMediaType = "application/json; charset=utf-8".toMediaType()
+
+    private val supabaseUrl = BuildConfig.SUPABASE_URL.trimEnd('/')
+
+    private val supabaseKey = BuildConfig.SUPABASE_PUBLISHABLE_KEY
+
+    data class AuthResult(
+        val success: Boolean,
+        val message: String,
+        val accessToken: String? = null,
+        val userId: String? = null,
+        val email: String? = null,
+    )
+
+    fun signIn(
+        email: String,
+        password: String,
+        callback: (AuthResult) -> Unit
+    ) {
+        authenticate(
+            endpoint = "token?grant_type=password",
+            email = email,
+            password = password,
+            callback = callback
+        )
+    }
+
+    fun signUp(
+        email: String,
+        password: String,
+        callback: (AuthResult) -> Unit
+    ) {
+        authenticate(
+            endpoint = "signup",
+            email = email,
+            password = password,
+            callback = callback
+        )
+    }
+
+    private fun authenticate(
+        endpoint: String,
+        email: String,
+        password: String,
+        callback: (AuthResult) -> Unit
+    ) {
+        if (supabaseUrl.isBlank() || supabaseKey.isBlank()) {
+            callback(
+                AuthResult(
+                    success = false,
+                    message = "Supabase configuration is missing. Check local.properties."
+                )
+            )
+            return
+        }
+
+        val requestJson = JSONObject().apply {
+            put("email", email.trim().lowercase())
+            put("password", password)
+        }
+
+        val request = Request.Builder()
+            .url("$supabaseUrl/auth/v1/$endpoint")
+            .header("apikey", supabaseKey)
+            .header("Content-Type", "application/json")
+            .post(requestJson.toString().toRequestBody(jsonMediaType))
+            .build()
+
+        Thread {
+            val result = try {
+                client.newCall(request).execute().use { response ->
+                    val responseBody = response.body?.string().orEmpty()
+                    val json = if (responseBody.isNotBlank()) {
+                        JSONObject(responseBody)
+                    } else {
+                        JSONObject()
+                    }
+
+                    if (response.isSuccessful) {
+                        val user = json.optJSONObject("user")
+                        val accessToken = json.optString("access_token")
+                            .takeIf { it.isNotBlank() }
+
+                        AuthResult(
+                            success = true,
+                            message = if (accessToken == null) {
+                                "Registration submitted. Check your email if verification is required."
+                            } else {
+                                "Authentication successful."
+                            },
+                            accessToken = accessToken,
+                            userId = user?.optString("id")?.takeIf { it.isNotBlank() },
+                            email = user?.optString("email")?.takeIf { it.isNotBlank() }
+                        )
+                    } else {
+                        AuthResult(
+                            success = false,
+                            message = json.optString(
+                                "msg",
+                                json.optString(
+                                    "message",
+                                    json.optString(
+                                        "error_description",
+                                        "Authentication failed. Please check your details."
+                                    )
+                                )
+                            )
+                        )
+                    }
+                }
+            } catch (_: IOException) {
+                AuthResult(
+                    success = false,
+                    message = "Unable to connect. Check your internet connection and try again."
+                )
+            } catch (_: Exception) {
+                AuthResult(
+                    success = false,
+                    message = "An unexpected authentication error occurred."
+                )
+            }
+
+            android.os.Handler(android.os.Looper.getMainLooper()).post {
+                callback(result)
+            }
+        }.start()
+    }
+}
